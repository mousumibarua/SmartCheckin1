<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F5F5F5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 🔐 Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:text="Enter PIN"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <!-- ●●●● PIN DOTS -->
    <TextView
        android:id="@+id/txtPinDots"
        android:text="○ ○ ○ ○"
        android:textSize="28sp"
        android:letterSpacing="0.3"
        android:textColor="#000000"
        android:layout_marginBottom="32dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <!-- 🔢 PIN GRID (IMPORTANT ID ADDED) -->
    <GridLayout
        android:id="@+id/pinGrid"
        android:columnCount="3"
        android:rowCount="4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp">

        <!-- Row 1 -->
        <Button android:text="1" style="@style/PinButtonStyle"/>
        <Button android:text="2" style="@style/PinButtonStyle"/>
        <Button android:text="3" style="@style/PinButtonStyle"/>

        <!-- Row 2 -->
        <Button android:text="4" style="@style/PinButtonStyle"/>
        <Button android:text="5" style="@style/PinButtonStyle"/>
        <Button android:text="6" style="@style/PinButtonStyle"/>

        <!-- Row 3 -->
        <Button android:text="7" style="@style/PinButtonStyle"/>
        <Button android:text="8" style="@style/PinButtonStyle"/>
        <Button android:text="9" style="@style/PinButtonStyle"/>

        <!-- Row 4 -->
        <View
            android:layout_width="72dp"
            android:layout_height="72dp"/>

        <Button android:text="0" style="@style/PinButtonStyle"/>

        <Button
            android:text="⌫"
            style="@style/PinButtonStyle"/>
    </GridLayout>

    <!-- 🚨 SOS BYPASS (NO PIN REQUIRED) -->
    <Button
        android:id="@+id/btnSOS"
        android:text="🚨 Emergency SOS"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:backgroundTint="#D32F2F"
        android:layout_width="match_parent"
        android:layout_height="48dp" />

</LinearLayout>
